+		// Convert desktop GLSL (1.10/1.20) into GLSL ES 1.00 for WebGL.
+		std::string translate_shader_for_webgl(const std::string& code, GLenum type)
+		{
+			std::stringstream in(code);
+			std::stringstream out;
+			const char nl = '\n';
+			out << "#version 100" << nl;
+			out << "#ifdef GL_FRAGMENT_PRECISION_HIGH" << nl << "precision highp float;" << nl << "precision highp int;" << nl
+			    << "#else" << nl << "precision mediump float;" << nl << "precision mediump int;" << nl << "#endif" << nl;
+			std::string line;
+			while(std::getline(in, line)) {
+				auto first = line.find_first_not_of(" \t");
+				if(first != std::string::npos && (line.compare(first, 8, "#version") == 0 || line.compare(first, 10, "#extension") == 0)) {
+					out << nl;
+					continue;
+				}
+				out << line << nl;
+			}
+			return out.str();
+		}
+#endif
